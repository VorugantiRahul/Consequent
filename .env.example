# ========================================================
# Consequent — Hindsight Configuration
# ========================================================

# Vectorize Hindsight API Key (Optional for cloud, leave blank for local daemon)
HINDSIGHT_API_KEY=

# Hindsight Base URL
# Default cloud: https://api.hindsight.vectorize.io
# Self-hosted / local docker daemon: http://localhost:8888
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Dedicated Memory Bank ID
HINDSIGHT_BANK_ID=consequent-operations

# Port
PORT=3000
